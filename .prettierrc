{
    "overrides": [
        {
            "files": "*.json",
            "options": {
                "tabWidth": 2
            }
        },
        {
            "files": "*.xml",
            "options": {
                "tabWidth": 2
            }
        },
        {
            "files": "*.csproj",
            "options": {
                "tabWidth": 2
            }
        },
        {
            "files": "*.esproj",
            "options": {
                "tabWidth": 2
            }
        },
        {
            "files": "*.config",
            "options": {
                "tabWidth": 2,
                "printWidth": 80
            }
        }
    ],
    "useTabs": false,
    "tabWidth": 4,
    "trailingComma": "all",
    "plugins": ["@ianvs/prettier-plugin-sort-imports"]
}
